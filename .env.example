# Copy to .env and fill in — never commit .env
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret
# Must match exactly what you set in Meta Developer Console → Facebook Login → Valid OAuth Redirect URIs
FB_REDIRECT_URI=http://localhost:3000/api/auth/callback
FB_GRAPH_VERSION=v19.0
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000
# SQLite file (default data/turnip.db)
DB_PATH=data/turnip.db
